umn}.pbody>span{color:var(--red)}.pbody h3{font-size:35px;letter-spacing:-.06em;margin:12px 0}.pbody p{line-height:1.7;color:var(--muted);margin:0 0 35px}.miniSpecs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:auto;margin-bottom:30px}.miniSpecs b{font-size:20px}.miniSpecs small{display:block;font:500 9px 'DM Mono',monospace;color:#777;margin-top:7px}.darkFeature{background:var(--dark);color:white;padding:120px 7vw;display:grid;grid-template-columns:1fr .8fr;gap:10vw;align-items:center}.darkFeature p{color:#aaa;line-height:1.75;max-width:600px}.featureProduct{height:560px;background:#202225;display:flex;align-items:center;justify-content:center;position:relative}.featureProduct img{max-height:90%;max-width:90%;object-fit:contain}.featureProduct span{position:absolute;bottom:18px;left:20px;color:#aaa;font:500 9px 'DM Mono',monospace}.compact{padding-top:90px;padding-bottom:90px}.process{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.process>div{padding:28px;border-right:1px solid var(--line);min-height:180px}.process>div:last-child{border:0}.process h4,.process h3{margin:22px 0 10px;font-size:16px}.process p{color:var(--muted);line-height:1.6;font-size:14px}.factory,.factoryHero{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:45px;position:relative}.factory img,.factoryHero img{width:100%;height:380px;object-fit:cover}.capacity,.bigCapacity{position:absolute;bottom:20px;left:20px;right:20px;background:var(--ink);color:white;padding:22px;display:flex;align-items:center;gap:20px}.capacity b,.bigCapacity b{font-size:52px}.capacity span,.bigCapacity span{font:500 10px 'DM Mono',monospace;line-height:1.5}.pageHero{padding:120px 7vw 100px;border-bottom:1px solid var(--line);max-width:var(--max);margin:auto}.productList{display:grid;gap:24px}.productList .productCard{min-height:520px}.productHero{max-width:var(--max);margin:auto;display:grid;grid-template-columns:1.