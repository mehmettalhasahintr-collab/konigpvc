 0 45px}.footerCta h2 em{font-family:Georgia,serif;font-weight:400}.footerGrid{max-width:var(--max);margin:60px auto 0;display:grid;grid-template-columns:1.4fr repeat(4,1fr) 1.5fr;gap:30px}.footerGrid>div{display:flex;flex-direction:column;gap:11px}.footerGrid b{color:#777}.footerGrid a,.footerGrid span,.footBrand small{font-size:12px;color:#c9cac9;line-height:1.5}.footBrand img{width:150px;background:white;padding:8px}.footBrand p{font:500 10px 'DM Mono',monospace;color:#fff}.footerMark{max-width:var(--max);margin:80px auto 30px;font-size:clamp(90px,18vw,270px);font-weight:800;letter-spacing:-.12em;color:#24272a;line-height:.7}.legal{max-width:var(--max);margin:auto;border-top:1px solid #36383a;padding-top:18px;display:flex;justify-content:space-between;gap:15px;color:#777}.adminLogin{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;background:#111315;color:white;padding:30px}.adminLogin img{width:170px;background:white;padding:8px;margin-bottom:20px}.adminLogin>span{font:500 10px 'DM Mono',monospace;color:#888}.adminLogin h1{font-size:60px;letter-spacing:-.07em}.adminLogin form{width:min(420px,100%);display:grid;gap:12px}.adminLogin input{padding:16px;border:1px solid #555;background:#202225;color:white}.adminLogin p{font:500 10px 'DM Mono',monospace;color:#888}.adminShell{min-height:100vh;background:#f2f2ef;display:grid;grid-template-columns:260px 1fr}.adminShell aside{background:#111315;color:white;padding:30px;display:flex;flex-direction:column;gap:7px}.adminShell aside img{width:130px;background:white;padding:5px;margin-bottom:8px}.adminShell aside span{color:#777;margin-bottom:25px}.adminShell aside button,.adminShell aside a{border:0;background:none;color:#aaa;text-align:left;padding:12px 0;cursor:pointer;font-size:13px}.adminShell aside button:hover,.adminShell aside a:hover{color:white}.adminMain{padding:35px 5vw}.adminTop{display:flex;justify-content:space-between;align-items:end;margin-bottom:40px}.adminTop h1{font-size:48px;letter-spacing:-.06em;margin:5px 0}.adminTop button{border:1px solid var(--ink);background:none;padding:10px}.adminCards{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.adminCards div{background:white;border:1px solid var(--line);padding:30px}.adminCards b{font-size:55px;display:block}.adminCards span{font:500 9px 'DM Mono',monospace;color:#777}.adminPanel{background:white;border:1px solid var(--line);padding:35px;margin-top:20px}.adminPanel h2{font-size:30px;letter-spacing:-.04em}.editProduct{border-top:2px solid var(--ink);padding:25px 0}.editHead{display:flex;justify-content:space-between;margin-bottom:20px}.editHead span{font:500 9px 'DM Mono',monospace;color:#777}.editGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.editGrid label{font:500 9px 'DM Mono',monospace;color:#777}.editGrid textarea{min-height:100px}.editProduct .btn{margin-top:25px}.pageEdit{display:grid;gap:10px;margin:0 0 25px}.pageEdit b{font:500 10px 'DM Mono',monospace;color:var(--red)}.projectAdminList{margin-top:30px}.projectAdminList>div{padding:18px;border-top:1px solid var(--line);display:flex;gap:20px;align-items:center}.projectAdminList span{color:#777;flex:1}.projectAdminList button{border:0;background:#eee;padding:7px 10px}.adminPanel code{background:#eee;padding:2px 5px}
@media(max-width:1100px){.top nav{display:none}.navCta{display:none}.hamb{display:block}.hero{grid-template-columns:1fr}.heroImage{min-height:65vh;border-left:0}.intro,.productHero,.brandStory,.deraGrid,.contactGrid,.darkFeature{grid-template-columns:1fr}.productHero .productSummary{padding:70px 7vw}.footerGrid{grid-template-columns:repeat(3,1fr)}.stats b{font-size:52px}.process{grid-template-columns:1fr 1fr}.process>div:nth-child(2){border-right:0}.process>div{border-bottom:1px solid var(--line)}}
@media(max-width:700px){.top{height:70px}.brand span{display:none}.brand img{width:90px}.heroCopy{padding:80px 7vw}.hero h1,.pageHero h1{font-size:58px}.heroImage{min-height:430px}.band,.section,.pageHero{padding:75px 6vw}.stats{grid-template-columns:1fr 1fr}.stats div{padding:28px 6vw}.stats b{font-size:45px}.productGrid{grid-template-columns:1fr}.productCard{grid-template-columns:1fr;min-height:0}.pvisual{height:350px}.pbody{padding:35px}.sectionHead{display:block}.sectionHead .textLink{display:inline-block;margin-top:25px}.darkFeature{padding:75px 7vw}.featureProduct{height:420px}.process{grid-template-columns:1fr}.process>div{border-right:0!important}.factory,.factoryHero,.quoteForm,.threeCols,.techBlocks,.professional,.colorPreview{grid-template-columns:1fr}.factory img,.factoryHero img{height:260px}.capacity{position:relative;left:0;right:0;bottom:0;margin-top:10px}.productSummary h2,.emptyState h2,.contactGrid h2{font-size:62px}.productHero{min-height:auto}.productLarge{min-height:470px}.ctHead,.ctRow{grid-template-columns:140px repeat(4,180px)}.compare{overflow:auto}.colorWall{grid-template-columns:1fr 1fr}.colorPreview>div:last-child{padding:45px}.catalog iframe{height:650px}.footerGrid{grid-template-columns:1fr 1fr}.footerGrid .contact{grid-column:1/-1}.legal{flex-direction:column}.adminShell{grid-template-columns:1fr}.adminShell aside{position:static}.adminMain{padding:25px}.adminCards{grid-template-columns:1fr 1fr}.editGrid{grid-template-columns:1fr}.adminTop h1{font-size:32px}}

/* REVISION 02 */
.brand img{width:158px;max-height:66px;object-fit:contain}.top{height:96px}.footBrand img{width:245px;max-width:100%;padding:0;background:transparent}.footerMark{font-size:clamp(110px,22vw,330px);letter-spacing:-.13em}.surfaceSample{width:72%;height:52%;background:var(--c);box-shadow:inset 0 0 0 1px rgba(0,0,0,.14),inset 0 18px 50px rgba(255,255,255,.18);position:relative}.surfaceSample:after{content:'';position:absolute;inset:0;background:repeating-linear-gradient(92deg,rgba(255,255,255,.09) 0 2px,transparent 2px 11px);mix-blend-mode:overlay}.techViewer{height:650px;background:#e8e9e6;border:1px solid var(--line);position:relative;overflow:hidden;touch-action:none}.viewerStage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden}.viewerStage img{max-width:78%;max-height:86%;object-fit:contain;transform-origin:center;user-select:none;cursor:grab;transition:transform .08s ease}.viewerNote{position:absolute;left:20px;bottom:18px;font:500 9px 'DM Mono',monospace;color:#777}.zoom{position:absolute;top:18px;border:1px solid var(--ink);background:rgba(255,255,255,.88);padding:9px 12px;font:700 10px 'DM Mono',monospace}.zIn{right:115px}.zOut{right:72px}.zReset{right:18px}.hotspotList{margin-top:28px;border-top:1px solid var(--line)}.hotspotList button{width:100%;border:0;border-bottom:1px solid var(--line);background:transparent;padding:13px 0;display:grid;grid-template-columns:34px 1fr auto;text-align:left;align-items:center;gap:10px;cursor:pointer}.hotspotList span{font:500 9px 'DM Mono',monospace;color:var(--red)}.hotspotList b{font-size:12px}.hotspotList em{font-style:normal;color:var(--muted);font-size:12px}.adminPanelHead{display:flex;justify-content:space-between;align-items:end}.submissionCard{border-top:2px solid var(--ink);padding:22px 0}.submissionCard>div:first-child{display:grid;gap:4px}.submissionCard>div:first-child span,.submissionCard>div:first-child small{color:#777}.submissionCard>p{color:#555;line-height:1.6}.status{font:700 9px 'DM Mono',monospace;display:inline-block;margin:12px 0;padding:7px 9px;border:1px solid var(--line)}.status-new{border-color:var(--red);color:var(--red)}.submissionActions{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.submissionActions button{border:1px solid var(--line);background:#f5f5f2;padding:8px 10px;font:700 9px 'DM Mono',monospace;cursor:pointer}.submissionCard>a{font:700 10px 'DM Mono',monospace;border-bottom:1px solid currentColor}.navopen .navlinks{display:flex!important;position:absolute;left:0;right:0;top:96px;background:var(--bg);padding:25px 6vw;flex-direction:column;border-bottom:1px solid var(--line);gap:18px}.navopen .navCta{display:block;position:absolute;right:70px}.productLarge{padding:0}.techViewer+.x{display:none}
@media(max-width:700px){.top{height:76px}.brand img{width:120px;max-height:58px}.navopen .navlinks{top:76px}.navopen .navCta{display:none}.techViewer{height:480px}.viewerStage img{max-width:90%;max-height:80%}.footerMark{font-size:30vw}.footBrand img{width:210px}}

/* REVISION 03 — COLOR STUDIO / TECH HOTSPOTS / KÖNİG BRAND */
.colorStudio{max-width:var(--max);display:grid;grid-template-columns:1.25fr .75fr;gap:0;padding-top:55px}
.colorStudioVisual{min-height:720px;background:#dfe3e4;position:relative;overflow:hidden}
.windowScene{position:absolute;inset:0;background:
 radial-gradient(circle at 76% 18%,rgba(255,255,255,.92),transparent 27%),
 linear-gradient(145deg,#c8d1d4 0%,#edf0ee 44%,#bcc5c5 100%);
}
.windowScene:before{content:'';position:absolute;inset:0;background:
 linear-gradient(120deg,rgba(255,255,255,.5),transparent 25%),
 linear-gradient(0deg,rgba(18,24,28,.10),transparent 35%);}
.sceneGlow{position:absolute;width:55%;height:70%;right:8%;top:9%;background:rgba(255,255,255,.34);filter:blur(40px)}
.windowShadow{position:absolute;left:17%;right:10%;bottom:10%;height:10%;background:rgba(0,0,0,.22);filter:blur(28px);border-radius:50%}
.premiumWindow{--frame-color:#7b4a2e;position:absolute;left:15%;right:13%;top:12%;bottom:13%;filter:drop-shadow(18px 25px 25px rgba(0,0,0,.18));transition:--frame-color .45s ease}
.frame{position:absolute;background:linear-gradient(120deg,color-mix(in srgb,var(--frame-color) 88%,white),var(--frame-color) 52%,color-mix(in srgb,var(--frame-color) 78%,black));z-index:5;box-shadow:inset 0 1px rgba(255,255,255,.45),inset 0 -3px 7px rgba(0,0,0,.16);transition:background .5s ease}
.frameTop,.frameBottom{left:0;right:0;height:24px}.frameTop{top:0}.frameBottom{bottom:0}.frameLeft,.frameRight{top:0;bottom:0;width:24px}.frameLeft{left:0}.frameRight{right:0}.frameMidV{top:0;bottom:0;left:49%;width:20px;transform:translateX(-50%)}.frameMidH{left:0;right:0;top:49%;height:20px;transform:translateY(-50%)}
.glass{position:absolute;background:
 linear-gradient(130deg,rgba(255,255,255,.68),rgba(147,190,207,.18) 42%,rgba(255,255,255,.22) 70%),
 linear-gradient(0deg,rgba(25,56,65,.11),transparent 50%);
 border:1px solid rgba(255,255,255,.58);box-shadow:inset 0 0 40px rgba(255,255,255,.22);overflow:hidden}
.glass:after{content:'';position:absolute;inset:-20%;background:linear-gradient(120deg,transparent 42%,rgba(255,255,255,.34) 50%,transparent 58%);transform:rotate(-8deg)}
.glassA{left:24px;top:24px;width:calc(49% - 34px);height:calc(49% - 34px)}.glassB{right:24px;top:24px;width:calc(51% - 34px);height:calc(49% - 34px)}.glassC{left:24px;bottom:24px;width:calc(49% - 34px);height:calc(51% - 34px)}.glassD{right:24px;bottom:24px;width:calc(51% - 34px);height:calc(51% - 34px)}
.handle{position:absolute;z-index:7;right:5.2%;top:44%;height:86px;width:12px;background:linear-gradient(#cfd1d1,#555);border-radius:8px;box-shadow:0 4px 10px rgba(0,0,0,.25)}
.handle:after{content:'';position:absolute;top:24px;left:-9px;width:30px;height:9px;background:#777;border-radius:8px}
.sill{position:absolute;left:-2%;right:-2%;bottom:-10px;height:16px;background:linear-gradient(#ddd,#aaa);z-index:6;box-shadow:0 5px 12px rgba(0,0,0,.2)}
.sceneLabel{position:absolute;left:24px;bottom:20px;z-index:9;font:500 8px 'DM Mono',monospace;color:#50565a;letter-spacing:.08em}
.colorStudioPanel{padding:70px 55px;background:#ececea;display:flex;flex-direction:column;justify-content:space-between;border-left:1px solid var(--line)}
.colorStudioPanel h2{font-size:clamp(52px,5vw,88px);line-height:.86;letter-spacing:-.08em;margin:0 0 10px}.colorStudioPanel p{color:var(--muted)}
.colorSelector{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:35px 0}
.colorOption{border:1px solid #cfd0cc;background:#f5f5f2;color:var(--ink);padding:12px;display:grid;grid-template-columns:28px 1fr;gap:2px 12px;text-align:left;cursor:pointer;transition:transform .25s ease,border-color .25s ease,background .25s ease}.colorOption:hover{transform:translateY(-2px)}.colorOption.selected{border:2px solid var(--ink);background:#fff;transform:scale(1.02)}.colorChip{grid-row:span 2;width:28px;height:44px;background:var(--chip);display:block;box-shadow:inset 0 0 0 1px rgba(0,0,0,.15)}.colorOption b{font-size:11px;align-self:end}.colorOption small{font:500 8px 'DM Mono',monospace;color:#777}
.colorMeta{border-top:1px solid #bbb;padding-top:18px}.colorMeta span{display:block;font:500 9px 'DM Mono',monospace;color:#777}.colorMeta strong{font-size:22px;display:block;margin-top:5px}
.colorEditorial{border-top:1px solid var(--line)}
/* hotspot viewer */
.techViewer{position:relative}.hotspotLayer{position:absolute;inset:0;z-index:12;pointer-events:none}.techHotspot{position:absolute;width:24px;height:24px;margin:-12px;border:1px solid rgba(17,18,20,.65);border-radius:50%;background:rgba(255,255,255,.76);padding:0;pointer-events:auto;cursor:pointer;display:grid;place-items:center;transition:transform .2s ease,background .2s ease}.techHotspot span{width:6px;height:6px;border-radius:50%;background:var(--red);display:block}.techHotspot em{position:absolute;left:18px;top:-7px;white-space:nowrap;background:rgba(17,18,20,.9);color:#fff;padding:6px 8px;font:500 8px 'DM Mono',monospace;font-style:normal;opacity:0;transform:translateX(-4px);transition:opacity .2s,transform .2s;pointer-events:none}.techHotspot:hover,.techHotspot.active{transform:scale(1.25);background:#fff}.techHotspot:hover em,.techHotspot.active em{opacity:1;transform:none}.hotspotPanel{position:absolute;right:20px;top:20px;width:min(280px,42%);background:rgba(17,18,20,.94);color:#fff;padding:24px;z-index:20;transform:translateX(18px);opacity:0;pointer-events:none;transition:.25s ease}.hotspotPanel.open{transform:none;opacity:1;pointer-events:auto}.hotspotPanel strong{display:block;font-size:27px;line-height:1.05;margin:8px 0}.hotspotPanel small{display:block;color:#aaa;font:500 9px 'DM Mono',monospace;line-height:1.5}.hotspotClose{position:absolute;right:8px;top:7px;background:none!important;color:#fff!important;font-size:20px;padding:4px;border:0!important}
.hotspotList button.active{background:#ececea}
/* brand page */
.konigHeroVisual{max-width:var(--max);margin:auto;padding:0 5vw 0}.konigHeroImage{height:610px;position:relative;overflow:hidden;background:#222}.konigHeroImage img{width:100%;height:100%;object-fit:cover;image-rendering:auto;filter:contrast(1.02) saturate(.9)}.konigHeroImage:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.72),transparent 62%),linear-gradient(0deg,rgba(0,0,0,.42),transparent 40%)}.konigHeroOverlay{position:absolute;z-index:2;left:6%;bottom:8%;color:#fff;display:flex;flex-direction:column}.konigHeroOverlay span{font:500 9px 'DM Mono',monospace;letter-spacing:.18em}.konigHeroOverlay strong{font-size:clamp(85px,15vw,220px);line-height:.72;letter-spacing:-.11em;margin:24px 0}.konigHeroOverlay small{font:600 10px 'DM Mono',monospace;letter-spacing:.18em}
.konigManifesto{padding-top:160px;padding-bottom:150px}.konigManifesto h2{font-size:clamp(68px,11vw,170px);line-height:.78;letter-spacing:-.09em;margin:35px 0 55px}.konigManifesto p{max-width:820px;margin-left:auto;font-size:21px;line-height:1.75;color:var(--muted)}
.konigDera{max-width:none;background:#e7e7e3;padding:100px 8vw;display:grid;grid-template-columns:1fr 100px 1fr;gap:30px;align-items:center;position:relative}.konigDeraBrand,.deraSide{display:flex;flex-direction:column;align-items:center;gap:18px}.konigDeraBrand img{width:min(360px,90%)}.deraSide img{width:min(430px,95%);mix-blend-mode:multiply}.konigDeraBrand span,.deraSide span{font:500 9px 'DM Mono',monospace;color:#777;letter-spacing:.14em}.konigDeraX{font-size:90px;text-align:center;font-weight:300;color:#aaa}.konigDeraText{grid-column:1/-1;max-width:850px;margin:25px auto 0;text-align:center;font-size:20px;line-height:1.7;color:#555}.konigDeraText strong{color:var(--ink)}
.konigStats{max-width:none;padding-left:0;padding-right:0}.konigStats .sectionHead{max-width:var(--max);margin-left:auto;margin-right:auto;padding:0 5vw}.konigStats .stats{max-width:var(--max);margin:auto;border-color:#383b3e}.konigStats .stats div{border-color:#383b3e}.konigStats .stats span{color:#999}
.konigProcess{padding-top:130px}.konigProcess .process.big>div{min-height:260px}.konigSystems{padding-top:130px}.konigClosing{background:#e5e5e1;padding:130px 7vw}.konigClosing>div{max-width:var(--max);margin:auto}.konigClosing h2{font-size:clamp(52px,7vw,110px);line-height:.88;letter-spacing:-.07em;margin:15px 0 45px}
/* transition helpers */
.premiumWindow{transition:filter .35s ease}.premiumWindow .frame{transition:background .45s cubic-bezier(.22,1,.36,1)}
@media(max-width:1100px){.colorStudio{grid-template-columns:1fr}.colorStudioVisual{min-height:620px}.colorStudioPanel{border-left:0;border-top:1px solid var(--line)}.konigHeroVisual{padding:0 5vw}.konigDera{grid-template-columns:1fr}.konigDeraX{font-size:55px}.konigDeraText{grid-column:auto}.konigHeroImage{height:500px}}
@media(max-width:700px){.colorStudio{padding-left:0;padding-right:0}.colorStudioVisual{min-height:480px}.premiumWindow{left:7%;right:7%;top:14%;bottom:16%}.colorStudioPanel{padding:45px 7vw}.colorSelector{grid-template-columns:1fr}.colorStudioPanel h2{font-size:58px}.colorOption.selected{transform:none}.sceneLabel{font-size:7px;left:12px;bottom:12px}.techHotspot{width:20px;height:20px;margin:-10px}.techHotspot em{display:none}.hotspotPanel{left:12px;right:12px;top:auto;bottom:14px;width:auto}.konigHeroVisual{padding:0}.konigHeroImage{height:390px}.konigHeroOverlay strong{font-size:100px}.konigManifesto{padding-top:90px;padding-bottom:90px}.konigManifesto p{margin-left:0;font-size:17px}.konigDera{padding:70px 6vw}.konigDeraBrand img{width:260px}.deraSide img{width:300px}.konigStats .sectionHead{padding:0 6vw}.konigStats .stats{grid-template-columns:1fr 1fr}.konigClosing{padding:85px 7vw}}

.premiumWindow[data-color="0"] .frame,.premiumWindow[data-color="1"] .frame,.premiumWindow[data-color="2"] .frame,.premiumWindow[data-color="3"] .frame,.premiumWindow[data-color="6"] .frame{background:linear-gradient(120deg,color-mix(in srgb,var(--frame-color) 88%,white),var(--frame-color) 52%,color-mix(in srgb,var(--frame-color) 75%,black)),repeating-linear-gradient(94deg,rgba(255,255,255,.08) 0 2px,transparent 2px 13px)}
.premiumWindow[data-color="4"] .frame,.premiumWindow[data-color="5"] .frame{background:linear-gradient(125deg,color-mix(in srgb,var(--frame-color) 86%,white),var(--frame-color) 48%,color-mix(in srgb,var(--frame-color) 72%,black))}
.premiumWindow[data-color="7"] .frame,.premiumWindow[data-color="8"] .frame{background:linear-gradient(135deg,#f2f3f2,var(--frame-color) 38%,#777 65%,#e8e9e8);box-shadow:inset 0 1px rgba(255,255,255,.65),inset 0 -3px 8px rgba(0,0,0,.22)}
