@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--bg:#f5f5f2;--ink:#111214;--muted:#686b6d;--line:#d7d8d4;--red:#df352b;--yellow:#f4d91c;--dark:#151719;--card:#ececea;--max:1440px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Manrope,Arial,sans-serif}a{text-decoration:none;color:inherit}button,input,textarea,select{font:inherit}.top{height:82px;padding:12px 4vw;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:rgba(245,245,242,.94);backdrop-filter:blur(16px);z-index:30}.brand{display:flex;align-items:center;gap:14px}.brand img{width:110px;height:auto}.brand span,.eyebrow,.top nav a,.pbody>span,.pnum,.sourceNote,.stats span,.process b,.contactDetails b,.footerGrid b,.footerMark+.legal,.adminShell aside span,.adminTop>div>span{font:500 10px 'DM Mono',monospace;letter-spacing:.13em}.top nav{display:flex;gap:26px}.top nav a{font-size:11px;letter-spacing:.04em}.top nav a:hover,.textLink:hover{color:var(--red)}.navCta{font:700 11px 'DM Mono',monospace;border-bottom:1px solid var(--ink);padding:10px 0}.hamb{display:none;border:0;background:none;font-size:22px}.hero{min-height:calc(100vh - 82px);display:grid;grid-template-columns:1.05fr .95fr;border-bottom:1px solid var(--line)}.heroCopy{padding:10vw 7vw 7vw;display:flex;flex-direction:column;justify-content:center}.eyebrow{display:block;color:#777;margin-bottom:24px}.hero h1,.pageHero h1{font-size:clamp(56px,7.6vw,122px);line-height:.88;letter-spacing:-.075em;margin:0;max-width:1100px}.hero h1 em,.pageHero h1 em,h2 em,h3 em{font-family:Georgia,serif;font-weight:400}.heroCopy>p,.pageHero>p{font-size:17px;line-height:1.75;max-width:680px;color:var(--muted);margin:34px 0}.actions{display:flex;gap:12px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;padding:16px 20px;border:1px solid var(--ink);font:700 11px 'DM Mono',monospace;letter-spacing:.04em}.btn.dark{background:var(--ink);color: