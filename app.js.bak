const $=s=>document.querySelector(s);const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
let DATA=null;
async function load(){const r=await fetch('/api/site');DATA=await r.json();render()}
const productById=id=>DATA.products.find(p=>p.id===id);
function header(){return `<header class="top"><a class="brand" href="/"><img src="/assets/konig-logo-transparent.png"><span>KÖNİG / PVC SİSTEMLERİ</span></a><nav><a href="/sistemler">Sistemler</a><a href="/teknik">Teknik</a><a href="/karsilastir">Karşılaştır</a><a href="/cozumler">Çözümler</a><a href="/renkler">Renkler</a><a href="/konig">KÖNİG</a><a href="/iletisim">İletişim</a></nav><a class="navCta" href="/teklif">PROJE TEKLİFİ AL <i>↗</i></a><button class="hamb" onclick="document.body.classList.toggle('navopen')">☰</button></header>`}
function footer(){return `<footer><div class="footerCta"><span>PROJE / ÜRETİM / İHRACAT</span><h2>Projenizi<br><em>konuşalım.</em></h2><div><a class="btn light" href="/teklif">PROJE TEKLİFİ AL ↗</a><a class="btn ghost" href="https://wa.me/905325831885">WHATSAPP'TAN ULAŞ ↗</a></div></div><div class="footerGrid"><div class="footBrand"><img src="/assets/konig-logo-transparent.png"><p>PVC KAPI &amp; PENCERE SİSTEMLERİ</p><small>KÖNİG<br>DERA PVC tarafından üretilmektedir.</small></div><div><b>SİSTEMLER</b>${DATA.products.map(p=>`<a href="/sistemler/${p.id}">${p.name}</a>`).join('')}</div><div><b>TEKNİK</b><a href="/teknik">Teknik Merkez</a><a href="/karsilastir">Sistem Karşılaştırma</a><a href="/renkler">Renkler</a><a href="/katalog">Katalog</a></div><div><b>PROJE</b><a href="/profesyoneller">Profesyoneller</a><a href="/teklif">Teklif Al</a></div><div><b>KURUMSAL</b><a href="/konig">KÖNİG</a><a href="/uretim">Üretim</a><a href="/dera">DERA</a><a href="/iletisim">İletişim</a></div><div class="contact"><b>KAYSERİ / TÜRKİYE</b><a href="tel:${DATA.settings.phone}">${DATA.settings.phone}</a><a href="https://wa.me/905325831885">${DATA.settings.whatsapp}</a><a href="mailto:${DATA.settings.email}">${DATA.settings.email}</a><span>${DATA.settings.address}</span></div></div><div class="footerMark">KÖNİG</div><div class="legal"><span>KÖNİG PVC KAPI VE PENCERE SİSTEMLERİ</span><span>© 2026 KÖNİG. Tüm hakları saklıdır.</span><span>Gizlilik · KVKK · Çerez Politikası</span></div></footer>`}
function pageHero(kicker,title,sub=''){return `<section class="pageHero"><span class="eyebrow">${kicker}</span><h1>${title}</h1>${sub?`<p>${sub}</p>`:''}</section>`}
function productCard(p,i){return `<article class="productCard"><div class="pnum">0${i+1}</div><div class="pvisual"><img src="${p.image}" alt="${p.name} profil kesiti" loading="lazy"></div><div class="pbody"><span>${p.type}</span><h3>${p.name}</h3><p>${p.description}</p><div class="miniSpecs"><b>${esc(p.profile)}<small>PROFİL</small></b><b>${esc(p.seals)}<small>CONTA</small></b><b>${esc(p.chambers)}<small>ODACIK</small></b></div><a class="textLink" href="/sistemler/${p.id}">SİSTEMİ İNCELE ↗</a></div></article>`}
function home(){return `<main><section class="hero"><div class="heroCopy"><span class="eyebrow">KÖNİG / PVC KAPI &amp; PENCERE SİSTEMLERİ</span><h1>Yapının <em>karakterini</em><br>oluşturan sistem.</h1><p>${esc(DATA.pages.home.subtitle)}</p><div class="actions"><a class="btn dark" href="/sistemler">SİSTEMLERİ KEŞFET ↗</a><a class="btn outline" href="/teklif">PROJE TEKLİFİ AL</a></div></div><div class="heroImage"><div class="heroFrame"></div><span>01 / KÖNİG SYSTEMS</span></div></section><section class="intro band"><div><span class="eyebrow">01 / KÖNİG — DERA</span><h2>Sistemi bilen,<br><em>projeyi anlayan</em> marka.</h2></div><p>KÖNİG; ürün, proje ve müşteri iletişiminin ana markasıdır. DERA PVC, Kayseri’deki üretim altyapısı ile KÖNİG sistemlerinin arkasındaki üretici yapıdır.</p></section><section class="stats"><div><b>25+</b><span>YIL SEKTÖR TECRÜBESİ</span></div><div><b>7+</b><span>ÜLKEYE ULAŞAN YAPI</span></div><div><b>120</b><span>ADET / GÜN KAPASİTE</span></div><div><b>24</b><span>AY GARANTİ</span></div></section><section class="section products"><div class="sectionHead"><div><span class="eyebrow">02 / ÜRÜN AİLESİ</span><h2>Dört sistem.<br><em>Tek marka yaklaşımı.</em></h2></div><a class="textLink" href="/sistemler">TÜM SİSTEMLER ↗</a></div><div class="productGrid">${DATA.products.map(productCard).join('')}</div></section><section class="darkFeature"><div><span class="eyebrow">03 / TEKNİK DENEYİM</span><h2>Kesiti sadece<br><em>görmeyin.</em> İnceleyin.</h2><p>Gerçek ürün kesitleri üzerinden sistemleri karşılaştırın; profil genişliği, odacık, conta, cam ve kaynakta belirtilen ısı iletkenlik değerlerini tek ekranda okuyun.</p><a class="btn light" href="/karsilastir">SİSTEMLERİ KARŞILAŞTIR ↗</a></div><div class="featureProduct"><img src="/assets/prime70.jpeg"><span>PRIME 70 / GERÇEK ÜRÜN GÖRSELİ</span></div></section><section class="section processSec"><div class="sectionHead"><div><span class="eyebrow">04 / ÜRETİM</span><h2>Ölçüden üretime,<br><em>kontrollü süreç.</em></h2></div><p>${esc(DATA.pages.uretim.subtitle)}</p></div><div class="process"><div><b>01</b><h4>ÖLÇÜ</h4><p>Doğru ölçü, doğru üretimin başlangıcı.</p></div><div><b>02</b><h4>SİSTEM</h4><p>Proje ihtiyacına göre ürün ve sistem seçimi.</p></div><div><b>03</b><h4>ÜRETİM</h4><p>Planlı ve kontrollü üretim akışı.</p></div><div><b>04</b><h4>KONTROL</h4><p>Teslim öncesi görsel ve süreç kontrolü.</p></div></div><div class="factory"><img src="/assets/factory-exterior.jpeg"><img src="/assets/factory-floor.jpeg"><div class="capacity"><b>120</b><span>KAYSERİ / TÜRKİYE<br>Katalogda belirtilen üretim kapasitesi.</span></div></div></section></main>`}
function systems(){return `<main>${pageHero('KÖNİG / SİSTEMLER','Dört sistem.<br><em>Farklı ihtiyaçlar.</em>','Katalogdaki dört sistem ailesini gerçek ürün kesitleriyle keşfedin.') }<section class="section productList">${DATA.products.map(productCard).join('')}</section></main>`}
function productPage(id){
 const p=productById(id); if(!p)return notFound();
 const rows=[['Profil genişliği',p.profile],['Odacık sayısı',p.chambers],['Conta sayısı',p.seals],['Conta tipi',p.sealType],['Cam kalınlıkları',p.glass],['Isı iletkenlik katsayısı',p.uf],['Standart',p.standard]];
 const valid=v=>v && !/^Kaynakta/i.test(String(v)) && String(v).trim()!=='—';
 const hotspotRows=rows.filter(r=>valid(r[1]));
 const hotspotPositions={
   'prime-70':[[48,72],[39,61],[57,67],[62,32],[47,45],[68,16],[30,83]],
   'prime-60':[[49,70],[39,59],[57,66],[63,31],[47,45],[67,16],[30,83]],
   'thermo-81':[[49,70],[39,58],[57,65],[63,31],[47,45],[67,16],[30,83]],
   'slide':[[49,71],[57,64],[63,31],[47,45],[67,16]]
 };
 const pos=hotspotPositions[p.id]||hotspotPositions['prime-60'];
 const hs=hotspotRows.map((r,i)=>`<button class="techHotspot" data-info="${i}" style="left:${pos[i%pos.length][0]}%;top:${pos[i%pos.length][1]}%" aria-label="${esc(r[0])}"><span></span><em>${esc(r[0])}</em></button>`).join('');
 return `<main>
 ${pageHero('KÖNİG / SİSTEM DETAYI',p.name,p.description)}
 <section class="productHero">
  <div class="productLarge">
   <div class="techViewer" id="viewer">
    <div class="viewerStage"><img id="viewerImg" src="${p.image}" alt="${p.name} gerçek profil kesiti"></div>
    <div class="hotspotLayer">${hs}</div>
    <div class="hotspotPanel" id="hotspotPanel"><button class="hotspotClose" aria-label="Kapat">×</button><span class="eyebrow" id="hotspotLabel">TEKNİK DETAY</span><strong id="hotspotValue"></strong><small id="hotspotSource">KÖNİG ${esc(p.name.replace('KÖNİG ','').trim())}</small></div>
    <button class="zoom zIn" data-zoom="1.15">+</button><button class="zoom zOut" data-zoom=".87">−</button><button class="zoom zReset">RESET</button>
    <div class="viewerNote">GERÇEK 2D KESİT / ZOOM / PAN / TEKNİK HOTSPOT</div>
   </div>
  </div>
  <div class="productSummary">
   <span class="eyebrow">TEKNİK ÖZELLİKLER</span><h2>Kesit.<br><em>Detay.</em></h2><p>${p.description}</p>
   <div class="highlightGrid"><div><b>${p.profile}</b><small>PROFİL GENİŞLİĞİ</small></div><div><b>${p.chambers}</b><small>ODACIK</small></div><div><b>${p.seals}</b><small>CONTA</small></div><div><b>${p.uf}</b><small>ISI İLETKENLİK KATSAYISI</small></div></div>
   <div class="hotspotList">${hotspotRows.map((r,i)=>`<button data-info="${i}"><span>0${i+1}</span><b>${r[0]}</b><em>${esc(r[1])}</em></button>`).join('')}</div>
  </div>
 </section>
 <section class="section"><div class="sectionHead"><div><span class="eyebrow">TEKNİK TABLO</span><h2>Kaynağa dayalı<br><em>spesifikasyon.</em></h2></div><span class="sourceNote">Eksik değerler tahmin edilmez.</span></div>
 <div class="techTable">${rows.map(r=>`<div><span>${r[0]}</span><b>${r[1]}</b></div>`).join('')}</div></section>
 <section class="section lightPanel"><div class="threeCols"><div><span>01</span><h4>CAM</h4><p>${esc(p.glass)}</p></div><div><span>02</span><h4>RENK</h4><p>9 farklı renk/dekor seçeneği.</p><a href="/renkler">RENKLERİ GÖR ↗</a></div><div><span>03</span><h4>KULLANIM ALANI</h4><p>${p.usage}</p></div></div></section>
 <section class="darkFeature compact"><div><span class="eyebrow">PROJE ODAKLI ÜRETİM</span><h2>Ürün, ölçü, cam,<br><em>renk ve donanım.</em></h2><p>Ürün, ölçü, cam, renk ve donanım proje ihtiyacına göre birlikte değerlendirilir.</p><a class="btn light" href="/teklif">PROJE TEKLİFİ AL ↗</a></div><div class="featureProduct"><img src="${p.image}" alt="${p.name}"></div></section>
 </main>`
}
function compare(){return `<main>${pageHero('KÖNİG / KARŞILAŞTIR','Sistemleri<br><em>karşılaştır.</em>','Kaynakta bulunan değerleri yan yana inceleyin. Eksik bilgiler açıkça belirtilir.')}<section class="section compare"><div class="compareControls">${DATA.products.map((p,i)=>`<label><input type="checkbox" ${i<3?'checked':''} value="${p.id}"><span>${p.name}</span></label>`).join('')}</div><div id="compareTable"></div></section></main>`}
function renderCompare(){const ids=[...document.querySelectorAll('.compareControls input:checked')].map(x=>x.value);const ps=ids.map(productById);$('#compareTable').innerHTML=`<div class="compareTable"><div class="ctHead"><div>TEKNİK ÖZELLİK</div>${ps.map(p=>`<div>${p.name}</div>`).join('')}</div>${[['Profil genişliği','profile'],['Odacık sayısı','chambers'],['Conta sayısı','seals'],['Conta tipi','sealType'],['Cam kalınlıkları','glass'],['Isı iletkenlik katsayısı','uf'],['Standart','standard'],['Kullanım alanı','usage']].map(([n,k])=>`<div class="ctRow"><div>${n}</div>${ps.map(p=>`<div>${esc(p[k])}</div>`).join('')}</div>`).join('')}</div>`}
function colors(){
 const swatches=['#7b4a2e','#b38a45','#7a352c','#38271f','#4a4e50','#516b5d','#8a7058','#aeb0b4','#d0d1d2'];
 const textures=['wood walnut','wood oak','wood mahogany','dark wood','anthracite','moss green','wood mersey','titanium silver','zinc silver'];
 return `<main>
 ${pageHero('KÖNİG / RENK & DEKOR','Mimarinin<br><em>tonunu seçin.</em>','Katalogda yer alan 9 gerçek renk/dekor adını, premium bir pencere deneyimi üzerinde keşfedin. Görsel pencere bir ürün sunum deneyimidir; gerçek KÖNİG ürün fotoğrafı olarak sunulmaz.')}
 <section class="colorStudio section">
   <div class="colorStudioVisual">
     <div class="windowScene">
       <div class="sceneGlow"></div>
       <div class="windowShadow"></div>
       <div class="premiumWindow" id="premiumWindow">
         <div class="frame frameTop"></div><div class="frame frameLeft"></div><div class="frame frameRight"></div><div class="frame frameBottom"></div>
         <div class="frame frameMidV"></div><div class="frame frameMidH"></div>
         <div class="glass glassA"></div><div class="glass glassB"></div><div class="glass glassC"></div><div class="glass glassD"></div>
         <div class="handle"></div><div class="sill"></div>
       </div>
       <span class="sceneLabel">GÖRSEL ÜRÜN DENEYİMİ / GERÇEK KÖNİG ÜRÜN FOTOĞRAFI DEĞİLDİR</span>
     </div>
   </div>
   <div class="colorStudioPanel">
     <div><span class="eyebrow">RENK / DEKOR</span><h2 id="colorName">${DATA.colors[0]}</h2><p id="colorDesc">KÖNİG renk/dekor seçeneği</p></div>
     <div class="colorSelector">${DATA.colors.map((c,i)=>`<button class="colorOption ${i===0?'selected':''}" data-color="${i}" style="--c:${swatches[i]}"><span class="colorChip" style="--chip:${swatches[i]}"></span><b>${c}</b><small>RENK / DEKOR</small></button>`).join('')}</div>
     <div class="colorMeta"><span>SEÇİLEN DEKOR</span><strong id="colorMetaName">${DATA.colors[0]}</strong></div>
   </div>
 </section>
 <section class="section colorEditorial"><div class="sectionHead"><div><span class="eyebrow">KÖNİG / DETAY</span><h2>Renk,<br><em>cepheye dönüşür.</em></h2></div><p>Renk deneyimi yalnızca bir renk kartı değildir. Kullanıcı, aynı pencere formu üzerinde seçilen dekorun görsel karakterini anında karşılaştırabilir.</p></div></section>
 </main>`
}
function technical(){return `<main>${pageHero('KÖNİG / TEKNİK MERKEZ','Teknik detay,<br><em>tasarımın temelidir.</em>','Katalogda doğrulanmış sistem bilgilerini tek yerde inceleyin.')}<section class="section"><div class="techBlocks"><a href="/karsilastir"><span>01</span><h3>Profil Sistemleri</h3><p>SLIDE · THERMO 81 · PRIME 60 · PRIME 70</p></a><div><span>02</span><h3>Conta Sistemleri</h3><p>TPE Gri / Siyah; sistem bazında conta sayısı ve tipi.</p></div><div><span>03</span><h3>Cam</h3><p>Sistemlere göre katalogda belirtilen cam kalınlıkları.</p></div><div><span>04</span><h3>Isı</h3><p>Kaynakta sayısal olarak verilen Uf değerleri gösterilir.</p></div><div><span>05</span><h3>Renk &amp; Dekor</h3><p>9 farklı renk/dekor seçeneği.</p></div><a href="/katalog"><span>06</span><h3>Teknik Dokümanlar</h3><p>KÖNİG kataloğunu tarayıcıda inceleyin.</p></a></div></section></main>`}
function production(){return `<main>${pageHero('KÖNİG / ÜRETİM','Ölçüden üretime,<br><em>kontrollü süreç.</em>',DATA.pages.uretim.subtitle)}<section class="section"><div class="factoryHero"><img src="/assets/factory-exterior.jpeg"><img src="/assets/factory-floor.jpeg"></div><div class="process big"><div><b>01</b><h3>ÖLÇÜ</h3><p>Doğru ölçü, doğru üretimin başlangıcı.</p></div><div><b>02</b><h3>SİSTEM</h3><p>Proje ihtiyacına göre ürün ve sistem seçimi.</p></div><div><b>03</b><h3>ÜRETİM</h3><p>Planlı ve kontrollü üretim akışı.</p></div><div><b>04</b><h3>KONTROL</h3><p>Teslim öncesi görsel ve süreç kontrolü.</p></div></div><div class="bigCapacity"><b>120</b><span>Katalogda belirtilen üretim kapasitesi · adet / gün</span></div></section></main>`}
function konig(){
 return `<main>
 ${pageHero('KÖNİG / MARKA','Sistemi bilen.<br><em>Projeyi anlayan.</em> marka.','KÖNİG; PVC kapı ve pencere sistemlerini proje ihtiyaçlarına göre kurgulayan, Kayseri merkezli bir yapı markasıdır.')}
 <section class="konigHeroVisual"><div class="konigHeroImage"><img src="/assets/factory-exterior.jpeg"><div class="konigHeroOverlay"><span>KAYSERİ / TÜRKİYE</span><strong>KÖNİG</strong><small>PVC KAPI & PENCERE SİSTEMLERİ</small></div></div></section>
 <section class="section konigManifesto"><span class="eyebrow">01 / MARKA YAKLAŞIMI</span><h2>SİSTEMİ BİLEN.<br><em>PROJEYİ ANLAYAN.</em></h2><p>KÖNİG, yalnızca bir ürün adı olarak değil; sistem, ölçü, cam, renk ve donanım kararlarını proje ihtiyacı etrafında bir araya getiren ana marka olarak konumlanır. Ürün ailesi; SLIDE, THERMO 81, PRIME 60 ve PRIME 70 sistemlerinden oluşur.</p></section>
 <section class="section konigDera"><div class="konigDeraBrand"><img src="/assets/konig-logo-transparent.png"><span>ANA MARKA</span></div><div class="konigDeraX">×</div><div class="deraSide"><img src="/assets/dera-logo.jpeg"><span>ÜRETİCİ YAPI</span></div><div class="konigDeraText"><p><strong>KÖNİG</strong> ürün, proje ve müşteri iletişiminin ana markasıdır. <strong>DERA PVC</strong>, Kayseri’deki üretim altyapısı ile KÖNİG sistemlerinin arkasındaki üretici yapıdır.</p></div></section>
 <section class="dark konigStats"><div class="sectionHead"><div><span class="eyebrow">02 / KAYNAKTAKİ GERÇEKLER</span><h2>Markayı anlatan<br><em>ölçülebilir veriler.</em></h2></div><p>Katalogda açıkça belirtilen marka ve üretim bilgileri.</p></div><div class="stats"><div><b>25+</b><span>YIL SEKTÖR TECRÜBESİ</span></div><div><b>7+</b><span>ÜLKEYE ULAŞAN YAPI</span></div><div><b>120</b><span>ADET / GÜN KAPASİTE</span></div><div><b>24</b><span>AY GARANTİ</span></div></div></section>
 <section class="section konigProcess"><div class="sectionHead"><div><span class="eyebrow">03 / ÜRETİM YAKLAŞIMI</span><h2>Ölçüden üretime,<br><em>kontrollü akış.</em></h2></div><p>Katalogda tarif edilen süreç; ölçü, sistem, üretim ve kontrol başlıkları üzerinden ilerler.</p></div><div class="process big"><div><b>01</b><h3>ÖLÇÜ</h3><p>Proje ihtiyacının doğru ölçüyle başlaması.</p></div><div><b>02</b><h3>SİSTEM</h3><p>İhtiyaca göre doğru sistemin belirlenmesi.</p></div><div><b>03</b><h3>ÜRETİM</h3><p>Belirlenen sisteme göre üretim akışı.</p></div><div><b>04</b><h3>KONTROL</h3><p>Teslim öncesi kontrol yaklaşımı.</p></div></div></section>
 <section class="section konigSystems"><div class="sectionHead"><div><span class="eyebrow">04 / SİSTEM AİLESİ</span><h2>Dört sistem.<br><em>Tek marka dili.</em></h2></div><p>Her sistemin kendi teknik karakteri bulunur. Kaynakta belirtilen bilgiler ürün sayfalarında ayrıntılı şekilde sunulur.</p></div><div class="productGrid">${DATA.products.map(p=>`<a class="productCard" href="/sistemler/${p.id}"><div class="pvisual"><img src="${p.image}" alt="${p.name}"></div><div class="pbody"><span>${p.type}</span><h3>${p.name}</h3><p>${p.description}</p><div class="miniSpecs"><div><b>${p.profile}</b><small>PROFİL</small></div><div><b>${p.seals}</b><small>CONTA</small></div><div><b>${p.chambers}</b><small>ODACIK</small></div></div><span class="textLink">SİSTEMİ İNCELE ↗</span></div></a>`).join('')}</div></section>
 <section class="konigClosing"><div><span class="eyebrow">05 / PROJE</span><h2>Bir sonraki projeniz için<br><em>doğru sistemi birlikte belirleyelim.</em></h2><a class="btn dark" href="/teklif">PROJE TEKLİFİ AL ↗</a></div></section>
 </main>`
}
function dera(){return `<main>${pageHero('KÖNİG / DERA','KÖNİG’in<br><em>üretici altyapısı.</em>',DATA.pages.dera.subtitle)}<section class="section deraGrid"><div><img src="/assets/dera-logo.jpeg"></div><div><span class="eyebrow">RESMİ KAYNAK</span><p>DERA PVC’nin resmi sitesinde KÖNİG markasının üreticisi olduğu ve Kayseri’de faaliyet gösterdiği belirtilmektedir.</p><a class="btn dark" href="https://www.derapvc.com.tr/kurumsal">DERA KURUMSAL SAYFASI ↗</a></div></div></section></main>`}
function projects(){return notFound()}
function professionals(){return `<main>${pageHero('KÖNİG / PROFESYONELLER','Müteahhitler,<br><em>mimarlar, proje ekipleri.</em>','Sistemleri hızlıca inceleyin, teknik bilgileri karşılaştırın ve proje talebinizi doğrudan iletin.')}<section class="section professional"><div><span>01</span><h2>Sistemleri<br><em>inceleyin.</em></h2><a href="/sistemler">ÜRÜN AİLESİ ↗</a></div><div><span>02</span><h2>Teknik bilgileri<br><em>karşılaştırın.</em></h2><a href="/karsilastir">KARŞILAŞTIR ↗</a></div><div><span>03</span><h2>Projenizi<br><em>gönderin.</em></h2><a href="/teklif">TEKLİF AL ↗</a></div></section></main>`}
function teklif(){return `<main>${pageHero('KÖNİG / PROJE TEKLİFİ','Projenizi<br><em>birlikte kuralım.</em>','Form gerçek backend endpointine gönderilecek şekilde tasarlanmıştır. Dosya yükleme alanı aktif admin altyapısına bağlanabilir.')}<section class="section formSec"><form id="quoteForm" class="quoteForm" enctype="multipart/form-data"><div><label>Ad Soyad<input required name="name"></label><label>Firma<input name="company"></label><label>Telefon<input required name="phone"></label><label>E-posta<input required type="email" name="email"></label></div><div><label>Proje Türü<select name="type"><option>Konut</option><option>Ticari</option><option>Villa</option><option>Diğer</option></select></label><label>Proje Konumu<input name="location"></label><label>Tahmini Proje Büyüklüğü<input name="size"></label><label>Mesaj<textarea name="message"></textarea></label><label class="file">Dosya / Proje PDF yükleme<input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png,.webp"></label><button class="btn dark" type="submit">TALEBİ GÖNDER ↗</button><p id="formStatus"></p></div></form></section></main>`}
function solutions(){return `<main>${pageHero('KÖNİG / ÇÖZÜMLER','Projeye göre<br><em>tamamlanan sistem.</em>','Isı, ses, güvenlik, estetik, renk, cam ve su yalıtımı başlıkları proje ihtiyacına göre değerlendirilir.')}<section class="section"><div class="techBlocks"><div><span>01</span><h3>Isı</h3><p>Isı performansı hedeflerine göre cam seçimi.</p></div><div><span>02</span><h3>Ses</h3><p>İhtiyaca göre ses konforunu destekleyen çözümler.</p></div><div><span>03</span><h3>Güvenlik</h3><p>Kullanım senaryosuna göre güvenlik odaklı seçenekler.</p></div><div><span>04</span><h3>Estetik</h3><p>Cephe ve iç mekân tasarımına uygun görünüm.</p></div><div><span>05</span><h3>Renk</h3><p>9 farklı renk/dekor seçeneği.</p></div><div><span>06</span><h3>Su Yalıtımı</h3><p>Yağmur ve dış ortam etkilerine karşı kontrollü koruma.</p></div></div></section></main>`}
function contact(){return `<main>${pageHero('KÖNİG / İLETİŞİM','KÖNİG ile<br><em>doğrudan iletişim.</em>',DATA.pages.iletisim.subtitle)}<section class="section contactGrid"><div><span class="eyebrow">KURUMSAL İLETİŞİM</span><h2>PROJE<br><em>ÜRETİM</em><br>İHRACAT</h2></div><div class="contactDetails"><p><b>TELEFON</b><a href="tel:${DATA.settings.phone}">${DATA.settings.phone}</a></p><p><b>WHATSAPP</b><a href="https://wa.me/905325831885">${DATA.settings.whatsapp}</a></p><p><b>E-POSTA</b><a href="mailto:${DATA.settings.email}">${DATA.settings.email}</a></p><p><b>İNTERNET</b><a href="https://${DATA.settings.website}">${DATA.settings.website}</a></p><p><b>SOSYAL MEDYA</b><span>${DATA.settings.instagram}</span></p><p><b>KONUM</b><span>${DATA.settings.address}</span></p></div></section></main>`}
function catalog(){return `<main>${pageHero('KÖNİG / KATALOG','KÖNİG kataloğu.<br><em>Teknik arşiv.</em>','Mevcut katalog tarayıcı içinde görüntülenebilir ve indirilebilir.')}<section class="section catalog"><div class="catalogActions"><a class="btn dark" href="/assets/konig-katalog.pdf" download>KATALOĞU İNDİR ↗</a></div><iframe src="/assets/konig-katalog.pdf" title="KÖNİG Kataloğu"></iframe></section></main>`}
function notFound(){return `<main>${pageHero('404','Sayfa bulunamadı.','Aradığınız KÖNİG sayfası mevcut değil.')}<section class="section"><a class="btn dark" href="/">ANA SAYFAYA DÖN ↗</a></section></main>`}
function admin(){return `<div id="adminApp"></div>`}
function route(){let p=location.pathname.replace(/\/$/,'')||'/';if(p==='/admin')return admin();let c=p==='/'?home():p==='/sistemler'?systems():p.startsWith('/sistemler/')?productPage(p.split('/')[2]):p==='/karsilastir'?compare():p==='/renkler'?colors():p==='/teknik'?technical():p==='/uretim'?production():p==='/konig'?konig():p==='/dera'?dera():p==='/cozumler'?solutions():p==='/profesyoneller'?professionals():p==='/teklif'?teklif():p==='/iletisim'?contact():p==='/katalog'?catalog():notFound();$('#app').innerHTML=header()+c+footer();bind();}
function bind(){document.querySelectorAll('a[href^="/"]').forEach(a=>a.onclick=e=>{if(a.target==='_blank')return;e.preventDefault();history.pushState({},'',a.getAttribute('href'));route();window.scrollTo(0,0)});
document.querySelectorAll('.colorOption').forEach(b=>b.onclick=()=>{const i=Number(b.dataset.color);const swatches=['#7b4a2e','#b38a45','#7a352c','#38271f','#4a4e50','#516b5d','#8a7058','#aeb0b4','#d0d1d2'];const name=DATA.colors[i];$('#colorName').textContent=name;$('#colorMetaName').textContent=name;$('#colorDesc').textContent='KÖNİG renk/dekor seçeneği';document.querySelectorAll('.colorOption').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');const w=$('#premiumWindow');if(w){w.style.setProperty('--frame-color',swatches[i]);w.dataset.color=i}});
document.querySelectorAll('.compareControls input').forEach(x=>x.onchange=renderCompare);if($('.compareTable'))renderCompare();const vi=$('#viewerImg');if(vi){let scale=1,x=0,y=0,drag=false,sx=0,sy=0;const apply=()=>vi.style.transform=`translate(${x}px,${y}px) scale(${scale})`;document.querySelectorAll('.zoom').forEach(b=>b.onclick=()=>{if(b.classList.contains('zReset')){scale=1;x=0;y=0}else scale*=Number(b.dataset.zoom);apply()});vi.parentElement.onpointerdown=e=>{if(e.target.closest('.techHotspot')||e.target.closest('.hotspotPanel'))return;drag=true;sx=e.clientX-x;sy=e.clientY-y;vi.parentElement.setPointerCapture(e.pointerId)};vi.parentElement.onpointermove=e=>{if(!drag)return;x=e.clientX-sx;y=e.clientY-sy;apply()};vi.parentElement.onpointerup=()=>drag=false;apply();
 const p=productById(location.pathname.split('/')[2]);const rows=p?[['Profil genişliği',p.profile],['Odacık sayısı',p.chambers],['Conta sayısı',p.seals],['Conta tipi',p.sealType],['Cam kalınlıkları',p.glass],['Isı iletkenlik katsayısı',p.uf],['Standart',p.standard]].filter(r=>r[1]&&!/^Kaynakta/i.test(String(r[1]))&&String(r[1])!=='—'):[];
 const openInfo=i=>{const r=rows[i];if(!r)return;$('#hotspotLabel').textContent=r[0];$('#hotspotValue').textContent=r[1];$('#hotspotSource').textContent='Kaynak: KÖNİG '+p.name.replace('KÖNİG ','');$('#hotspotPanel').classList.add('open');document.querySelectorAll('.techHotspot').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.techHotspot')[i]?.classList.add('active')};
 document.querySelectorAll('.techHotspot,.hotspotList button').forEach(b=>b.onclick=()=>openInfo(Number(b.dataset.info)));
 $('.hotspotClose')?.addEventListener('click',()=>$('#hotspotPanel').classList.remove('open'));
 document.querySelectorAll('.techHotspot').forEach(b=>b.addEventListener('mouseenter',()=>openInfo(Number(b.dataset.info))));
 }if($('#quoteForm'))$('#quoteForm').onsubmit=async e=>{e.preventDefault();const fd=new FormData(e.target);const r=await fetch('/api/quote',{method:'POST',body:fd});const x=await r.json();$('#formStatus').textContent=x.ok?'Talebiniz kaydedildi. KÖNİG ekibi iletişim bilgilerinizi değerlendirebilir.':'Talep gönderilemedi.';if(x.ok)e.target.reset()};}
async function adminApp(){const r=await fetch('/api/admin/me');const me=await r.json();if(!me.authenticated){$('#adminApp').innerHTML=`<div class="adminLogin"><img src="/assets/konig-logo-transparent.png"><span>ADMIN / CONTENT PLATFORM</span><h1>Yönetim paneli.</h1><form id="login"><input name="username" placeholder="Kullanıcı adı" value="admin"><input name="password" type="password" placeholder="Şifre"><button class="btn dark">GİRİŞ YAP ↗</button><p id="loginStatus">İlk kurulum şifresi: Konig2026!</p></form></div>`;$('#login').onsubmit=async e=>{e.preventDefault();const x=Object.fromEntries(new FormData(e.target));const r=await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(x)});if(r.ok)adminApp();else $('#loginStatus').textContent=(await r.json()).error};return}let d=await (await fetch('/api/admin/db')).json();$('#adminApp').innerHTML=`<div class="adminShell"><aside><img src="/assets/konig-logo-transparent.png"><span>CONTENT PLATFORM</span><button data-tab="dashboard">Dashboard</button><button data-tab="products">Ürünler</button><button data-tab="pages">Site İçerikleri</button><button data-tab="projects">Projeler</button><button data-tab="submissions">Teklif Talepleri</button><button data-tab="colors">Renkler</button><button data-tab="catalog">Katalog</button><button data-tab="contact">İletişim</button><button data-tab="security">Güvenlik</button><a href="/">← Public site</a></aside><section class="adminMain"><div class="adminTop"><div><span>ADMIN</span><h1>KÖNİG yönetim paneli</h1></div><button id="logout">Çıkış</button></div><div id="adminContent"></div></section></div>`;let tab='dashboard';const content=$('#adminContent');async function refresh(){d=await (await fetch('/api/admin/db')).json();renderTab()}function renderTab(){if(tab==='dashboard')content.innerHTML=`<div class="adminCards"><div><b>${d.products.length}</b><span>ÜRÜN</span></div><div><b>${d.projects.length}</b><span>PROJE</span></div><div><b>${d.colors.length}</b><span>RENK</span></div><div><b>${(d.submissions||[]).filter(x=>(x.status||'new')==='new').length}</b><span>YENİ TALEP</span></div><div><b>120</b><span>ADET / GÜN</span></div></div><div class="adminPanel"><h2>Yayın durumu</h2><p>Public site verileri <code>data/db.json</code> üzerinden merkezi olarak yönetiliyor. Değişiklikler kaydedildiğinde anında public siteye yansır.</p></div>`;else if(tab==='products')renderProducts();else if(tab==='pages')renderPages();else if(tab==='projects')renderProjects();else if(tab==='submissions')renderSubmissions();else if(tab==='colors')renderColors();else if(tab==='catalog')renderCatalog();else if(tab==='contact')renderContact();else renderSecurity()}
function renderProducts(){content.innerHTML=`<div class="adminPanel"><h2>Ürünler</h2>${d.products.map(p=>`<form class="editProduct" data-id="${p.id}"><div class="editHead"><b>${p.name}</b><span>${p.active?'YAYINDA':'GİZLİ'}</span></div><div class="editGrid"><label>Açıklama<textarea name="description">${esc(p.description)}</textarea></label><label>Profil<input name="profile" value="${esc(p.profile)}"></label><label>Odacık<input name="chambers" value="${esc(p.chambers)}"></label><label>Conta<input name="seals" value="${esc(p.seals)}"></label><label>Conta tipi<input name="sealType" value="${esc(p.sealType)}"></label><label>Cam<input name="glass" value="${esc(p.glass)}"></label><label>Uf<input name="uf" value="${esc(p.uf)}"></label><label>Standart<input name="standard" value="${esc(p.standard)}"></label><label>Kullanım alanı<input name="usage" value="${esc(p.usage)}"></label><label>Yayınla<select name="active"><option value="true" ${p.active?'selected':''}>Yayınla</option><option value="false" ${!p.active?'selected':''}>Gizle</option></select></label></div><button class="btn dark">KAYDET</button></form>`).join('')}</div>`;document.querySelectorAll('.editProduct').forEach(f=>f.onsubmit=async e=>{e.preventDefault();const x=Object.fromEntries(new FormData(f));x.active=x.active==='true';await fetch('/api/admin/products/'+f.dataset.id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(x)});await refresh()})}
function renderPages(){content.innerHTML=`<div class="adminPanel"><h2>Site içerikleri</h2>${Object.entries(d.pages).map(([k,p])=>`<div class="pageEdit"><b>${k.toUpperCase()}</b><input data-k="${k}" data-f="title" value="${esc(p.title)}"><textarea data-k="${k}" data-f="subtitle">${esc(p.subtitle)}</textarea><input data-k="${k}" data-f="cta" value="${esc(p.cta||'')}" placeholder="CTA"></div>`).join('')}<button class="btn dark" id="savePages">SAYFALARI KAYDET</button></div>`;$('#savePages').onclick=async()=>{const pages=structuredClone(d.pages);document.querySelectorAll('.pageEdit [data-k]').forEach(x=>pages[x.dataset.k][x.dataset.f]=x.value);await fetch('/api/admin/pages',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(pages)});await refresh()}}
function renderProjects(){content.innerHTML=`<div class="adminPanel"><h2>Projeler</h2><form id="newProject" class="editGrid"><input name="name" placeholder="Proje adı"><input name="location" placeholder="Konum"><input name="category" placeholder="Kategori"><input name="system" placeholder="Kullanılan sistem"><textarea name="description" placeholder="Açıklama"></textarea><input name="date" placeholder="Tarih"><select name="active"><option value="true">Yayınla</option><option value="false">Gizle</option></select><button class="btn dark">PROJE EKLE</button></form><div class="projectAdminList">${d.projects.map(p=>`<div><b>${esc(p.name)}</b><span>${esc(p.location||'')}</span><button data-del="${p.id}">Sil</button></div>`).join('')||'<p>Henüz gerçek proje eklenmedi.</p>'}</div></div>`;$('#newProject').onsubmit=async e=>{e.preventDefault();const x=Object.fromEntries(new FormData(e.target));x.active=x.active==='true';await fetch('/api/admin/projects',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(x)});await refresh()};document.querySelectorAll('[data-del]').forEach(b=>b.onclick=async()=>{await fetch('/api/admin/projects/'+b.dataset.del,{method:'DELETE'});refresh()})}
async function renderSubmissions(){const r=await fetch('/api/admin/submissions');const items=await r.json();const statusLabel=s=>s==='new'?'OKUNMADI':s==='read'?'OKUNDU':s==='replied'?'CEVAPLANDI':'ARŞİVLENDİ';content.innerHTML=`<div class="adminPanel"><div class="adminPanelHead"><div><span class="eyebrow">GELEN TALEPLER</span><h2>Müşteri talepleri</h2></div><b>${items.filter(x=>(x.status||'new')==='new').length} YENİ</b></div>${items.length?items.slice().reverse().map(x=>`<article class="submissionCard"><div><b>${esc(x.name||'İsimsiz')}</b><span>${esc(x.company||'')} · ${esc(x.phone||'')} · ${esc(x.email||'')}</span><small>${esc(x.createdAt||'')}</small></div><strong class="status status-${x.status||'new'}">${statusLabel(x.status||'new')}</strong><p>${esc(x.message||'')}</p>${x.file?`<a href="${esc(x.file)}" target="_blank">Dosyayı aç ↗</a>`:''}<div class="submissionActions"><button data-status="read" data-id="${x.id}">OKUNDU</button><button data-status="replied" data-id="${x.id}">CEVAPLANDI</button><button data-status="archived" data-id="${x.id}">ARŞİVLE</button></div></article>`).join(''):'<p>Henüz teklif talebi yok.</p>'}</div>`;document.querySelectorAll('.submissionActions button').forEach(b=>b.onclick=async()=>{await fetch('/api/admin/submissions/'+b.dataset.id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:b.dataset.status})});refresh()})}
function renderColors(){content.innerHTML=`<div class="adminPanel"><h2>Renk & Dekor</h2><textarea id="colorsEdit" rows="10">${d.colors.join('\n')}</textarea><button class="btn dark" id="saveColors">RENKLERİ KAYDET</button></div>`;$('#saveColors').onclick=async()=>{const colors=$('#colorsEdit').value.split('\n').map(x=>x.trim()).filter(Boolean);await fetch('/api/admin/colors',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(colors)});refresh()}}
function renderCatalog(){content.innerHTML=`<div class="adminPanel"><h2>Katalog</h2><p>Aktif katalog: <a href="${d.catalog}">${d.catalog}</a></p><form id="uploadForm" enctype="multipart/form-data"><input type="file" name="file" accept=".pdf"><button class="btn dark">YÜKLE VE AKTİF ET</button></form><p id="upStatus"></p></div>`;$('#uploadForm').onsubmit=async e=>{e.preventDefault();const fd=new FormData(e.target);const r=await fetch('/api/admin/upload',{method:'POST',body:fd});const x=await r.json();if(x.ok){await fetch('/api/admin/catalog',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({catalog:x.url})});$('#upStatus').textContent='Katalog yüklendi.';refresh()}else $('#upStatus').textContent=x.error}}
function renderContact(){content.innerHTML=`<div class="adminPanel"><h2>İletişim</h2><form id="settingsForm" class="editGrid">${Object.entries(d.settings).map(([k,v])=>`<label>${k}<input name="${k}" value="${esc(v)}"></label>`).join('')}<button class="btn dark">İLETİŞİM BİLGİLERİNİ KAYDET</button></form></div>`;$('#settingsForm').onsubmit=async e=>{e.preventDefault();await fetch('/api/admin/settings',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});refresh()}}
function renderSecurity(){content.innerHTML=`<div class="adminPanel"><h2>Güvenlik</h2><form id="passForm"><input type="password" name="password" placeholder="Yeni admin şifresi"><button class="btn dark">ŞİFREYİ DEĞİŞTİR</button></form><p>Şifreler sunucuda hash olarak saklanır; frontend koduna gömülmez.</p></div>`;$('#passForm').onsubmit=async e=>{e.preventDefault();const x=Object.fromEntries(new FormData(e.target));const r=await fetch('/api/admin/password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(x)});alert((await r.json()).ok?'Şifre güncellendi.':'İşlem başarısız.')}}
document.querySelectorAll('.adminShell aside button')?.forEach(b=>b.onclick=()=>{tab=b.dataset.tab;renderTab()});$('#logout')?.addEventListener('click',async()=>{await fetch('/api/logout',{method:'POST'});location.href='/admin'});renderTab()}
function render(){if(location.pathname==='/admin')return adminApp();route()}
window.addEventListener('popstate',render);load();
